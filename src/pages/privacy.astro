---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Privacy · Green Loom" description="How Green Loom handles follow-update email and consent.">
	<Header />
	<main class="gl-privacy">
		<h1>Privacy</h1>
		<p>
			Green Loom collects email and optional role only when you ask to follow updates, and only
			after you consent. We use that contact to send progress, decisions, and ways to weigh in.
		</p>
		<p>
			We do not sell your email. You can unsubscribe anytime from any message. Form processing
			vendor is not finalized yet (Q-002); when chosen, this page will name the processor and
			retention details.
		</p>
		<p>
			Questions about privacy: contact the Green Loom team through the channels listed on
			greenloom.com when available.
		</p>
		<p><a href={withBase()}>Back to Green Loom</a></p>
	</main>
	<Footer />
</BaseLayout>
