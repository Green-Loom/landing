---
import { withBase } from '../lib/paths';
---

<div class="gl-follow-form-wrap" data-follow-form>
	<form class="gl-follow-form" novalidate aria-label="Follow Green Loom updates">
		<input type="hidden" name="source_section" value="follow" />

		<label class="gl-field">
			<span class="gl-field__label">Email</span>
			<input
				type="email"
				name="email"
				autocomplete="email"
				required
				placeholder="you@shop.com"
			/>
			<span class="gl-field-error" role="alert" data-error="email" hidden></span>
		</label>

		<label class="gl-field">
			<span class="gl-field__label">What describes you? (optional)</span>
			<span class="gl-select">
				<select name="role">
					<option value="">Select one</option>
					<option value="operator">Operator</option>
					<option value="builder-agency">Builder / agency</option>
					<option value="other">Other</option>
				</select>
				<span class="gl-select__icon" aria-hidden="true"></span>
			</span>
		</label>

		<label class="gl-consent">
			<input type="checkbox" name="consent" required />
			<span>
				Email me Green Loom updates. I can unsubscribe anytime.
				<a href={withBase('privacy/')}>Privacy</a>
			</span>
		</label>
		<span class="gl-field-error" role="alert" data-error="consent" hidden></span>

		<p class="gl-form-error" role="alert" data-error="form" hidden></p>

		<button type="submit">Follow updates</button>
	</form>

	<div class="gl-success" role="status" hidden>
		You are on the list. We will write when there is something real to say.
	</div>
</div>

<script>
	import '../scripts/follow-form.ts';
</script>
