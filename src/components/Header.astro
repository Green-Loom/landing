---
import { withBase, withHash } from '../lib/paths';

interface Props {
	homeHref?: string;
	followHref?: string;
}

const {
	homeHref = withBase(),
	followHref = withHash('follow'),
} = Astro.props;
---

<header>
	<div class="gl-sticky-bar">
		<div class="gl-brand-mark">
			<img src={withBase('img/green-loom-logo.svg')} alt="" width="18" height="18" />
			<a href={homeHref}>Green Loom</a>
		</div>
		<a href={followHref}>Follow updates</a>
	</div>
</header>
