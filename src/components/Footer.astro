---
import { withBase, withHash } from '../lib/paths';

interface Props {
	followHref?: string;
}

const { followHref = withHash('follow') } = Astro.props;
---

<footer class="gl-footer">
	<p>
		© Green Loom. <a href={withBase('privacy/')}>Privacy</a>.
		<a href={followHref}>Unsubscribe</a>.
	</p>
</footer>
