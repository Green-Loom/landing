---
const faqs = [
	{
		q: 'Is Green Loom a POS?',
		a: 'Green Loom is a modular layer that connects and extends the systems you already use.',
	},
	{
		q: 'Where are the products?',
		a: 'We are starting with storefront, workflow, compliance, and integration tools. Follow updates to see each one take shape.',
	},
	{
		q: 'Do you only work with big licensed chains?',
		a: 'Green Loom is for independent shops, growing teams, delivery operators, and the people who support them.',
	},
	{
		q: 'Is this only for cannabis?',
		a: 'Cannabis is the starting point. The broader aim is regulated retail.',
	},
	{
		q: 'What will you email me?',
		a: 'Product progress and occasional ways to weigh in. Unsubscribe anytime.',
	},
];
---

<section class="gl-tile gl-tile--surface" id="faq">
	<div class="gl-tile__inner">
		<h2>Questions.</h2>
		<div class="gl-faq">
			{
				faqs.map((item) => (
					<details>
						<summary>{item.q}</summary>
						<p>{item.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
