---
const goals = [
	{
		n: '01',
		title: 'Better storefronts',
		body: 'Give customers a clear, compliant way to shop.',
	},
	{
		n: '02',
		title: 'Cleaner operations',
		body: 'Move orders smoothly from checkout to pickup or delivery.',
	},
	{
		n: '03',
		title: 'Rules in the workflow',
		body: 'Guide each team member at the moment a rule matters.',
	},
	{
		n: '04',
		title: 'Connected systems',
		body: 'Keep data flowing and integration health visible.',
	},
];
---

<section class="gl-tile gl-tile--light" id="goals">
	<div class="gl-tile__inner">
		<h2>What Green Loom brings together.</h2>
		<p class="gl-tile__sub">A smoother experience for customers, teams, and operators.</p>
		<div class="gl-goals">
			{
				goals.map((goal) => (
					<div class="gl-goal">
						<span class="gl-goal__n">{goal.n}</span>
						<div>
							<h3>{goal.title}</h3>
							<p>{goal.body}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
