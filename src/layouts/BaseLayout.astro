---
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/500.css';
import '@fontsource/figtree/600.css';
import '@fontsource/figtree/700.css';
import '../styles/tokens.css';
import '../styles/atmosphere.css';
import { withBase } from '../lib/paths';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Green Loom',
	description = 'Modular tools for regulated cannabis retail.',
} = Astro.props;

const imgHero = `url(${withBase('img/green-loom-rhythm-hero.jpg')})`;
const imgProblem = `url(${withBase('img/green-loom-systems-flow.jpg')})`;
const imgGoals = `url(${withBase('img/green-loom-capabilities-plume.jpg')})`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<title>{title}</title>
	</head>
	<body style={`--gl-img-hero: ${imgHero}; --gl-img-problem: ${imgProblem}; --gl-img-goals: ${imgGoals};`}>
		<slot />
	</body>
</html>
