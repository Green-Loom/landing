{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "48rem",
			"wideSize": "72rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#1d1d1f",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#39823D",
					"name": "Loom Green"
				},
				{
					"slug": "primary-soft",
					"color": "#6FB86E",
					"name": "Loom Leaf"
				},
				{
					"slug": "secondary",
					"color": "#86868b",
					"name": "Secondary"
				},
				{
					"slug": "tertiary",
					"color": "#f5f5f7",
					"name": "Surface"
				},
				{
					"slug": "hero",
					"color": "#000000",
					"name": "Ink"
				},
				{
					"slug": "mist",
					"color": "#f5f5f7",
					"name": "Mist"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Figtree\", \"SF Pro Display\", \"Segoe UI\", system-ui, sans-serif",
					"name": "Figtree",
					"slug": "body",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/figtree/v9/_Xmz-HUzqDCFdtQlYpWf4FqL_vWJ.woff2"
							]
						}
					]
				},
				{
					"fontFamily": "\"Figtree\", \"SF Pro Display\", \"Segoe UI\", system-ui, sans-serif",
					"name": "Figtree Display",
					"slug": "heading",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/figtree/v9/_Xmz-HUzqDCFdtQlYpWf4FqL_vWJ.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1.0625rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.3125rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "clamp(2rem, 1.4rem + 2vw, 2.75rem)",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "clamp(2.75rem, 1.6rem + 4vw, 4.5rem)",
					"name": "XX Large"
				}
			]
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "2"
				},
				{
					"slug": "30",
					"size": "0.75rem",
					"name": "3"
				},
				{
					"slug": "40",
					"size": "1rem",
					"name": "4"
				},
				{
					"slug": "50",
					"size": "1.5rem",
					"name": "5"
				},
				{
					"slug": "60",
					"size": "2.5rem",
					"name": "6"
				},
				{
					"slug": "70",
					"size": "5rem",
					"name": "7"
				},
				{
					"slug": "80",
					"size": "8rem",
					"name": "8"
				}
			]
		},
		"border": {
			"radiusSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "980px"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "18px"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.47",
			"letterSpacing": "-0.01em"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			},
			"blockGap": "0.8rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.07",
					"letterSpacing": "-0.025em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.25rem",
					"letterSpacing": "-0.015em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"button": {
				"border": {
					"radius": "980px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontSize": "1.0625rem",
					"fontWeight": "400"
				},
				"spacing": {
					"padding": {
						"top": "0.7rem",
						"right": "1.35rem",
						"bottom": "0.7rem",
						"left": "1.35rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/details": {
				"border": {
					"color": "#d2d2d7",
					"style": "solid",
					"width": "0 0 1px 0"
				},
				"spacing": {
					"padding": {
						"top": "1.1rem",
						"right": "0",
						"bottom": "1.1rem",
						"left": "0"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-privacy",
			"title": "Privacy",
			"postTypes": ["page"]
		}
	]
}
