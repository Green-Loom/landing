{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "base",
					"color": "#F3F7F3",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#132418",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#39823D",
					"name": "Loom Green"
				},
				{
					"slug": "primary-soft",
					"color": "#6FB86E",
					"name": "Loom Leaf"
				},
				{
					"slug": "secondary",
					"color": "#4A5C4E",
					"name": "Secondary"
				},
				{
					"slug": "tertiary",
					"color": "#DCE8DD",
					"name": "Tertiary"
				},
				{
					"slug": "hero",
					"color": "#0C1A10",
					"name": "Hero Depth"
				},
				{
					"slug": "mist",
					"color": "#E8F1E9",
					"name": "Mist"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Fraunces\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, serif",
					"name": "Fraunces",
					"slug": "heading",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontWeight": "500 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/fraunces/v38/6NUh8FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c8FWY.woff2"
							]
						}
					]
				},
				{
					"fontFamily": "\"Figtree\", \"Segoe UI\", sans-serif",
					"name": "Figtree",
					"slug": "body",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/figtree/v9/_Xmz-HUzqDCFdtQlYpWf4FqL_vWJ.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1.0625rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem)",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem)",
					"name": "XX Large"
				}
			]
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "2"
				},
				{
					"slug": "30",
					"size": "0.75rem",
					"name": "3"
				},
				{
					"slug": "40",
					"size": "1rem",
					"name": "4"
				},
				{
					"slug": "50",
					"size": "1.5rem",
					"name": "5"
				},
				{
					"slug": "60",
					"size": "2.5rem",
					"name": "6"
				},
				{
					"slug": "70",
					"size": "4rem",
					"name": "7"
				},
				{
					"slug": "80",
					"size": "6rem",
					"name": "8"
				}
			]
		},
		"border": {
			"radiusSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "4px"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "8px"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.55"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--50)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--50)"
			},
			"blockGap": "1.5rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600"
				},
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"right": "1.35rem",
						"bottom": "0.85rem",
						"left": "1.35rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--primary-soft)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--tertiary)"
				}
			},
			"core/details": {
				"border": {
					"color": "var(--wp--preset--color--tertiary)",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--40)",
						"left": "var(--wp--preset--spacing--50)"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-privacy",
			"title": "Privacy",
			"postTypes": ["page"]
		}
	]
}
