{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Green Loom Landing",
		"author": "Green Loom",
		"description": "Activate the Green Loom marketing block theme and open the front page."
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "6.7"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"siteOptions": {
		"blogname": "Green Loom",
		"blogdescription": "Modular tools for regulated cannabis retail",
		"show_on_front": "posts"
	},
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/Green-Loom/landing",
				"ref": "main",
				"refType": "branch",
				"path": "/"
			},
			"options": {
				"activate": true
			},
			"ifAlreadyInstalled": "overwrite"
		},
		{
			"step": "wp-cli",
			"command": "wp post create --post_type=page --post_title='Privacy' --post_name=privacy --post_status=publish --meta_input='{\"_wp_page_template\":\"page-privacy\"}'"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Green Loom",
				"blogdescription": "Modular tools for regulated cannabis retail"
			}
		}
	]
}
